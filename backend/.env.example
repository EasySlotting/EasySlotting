# Copy to backend/.env. Never reuse production credentials locally.
RAILS_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password
DB_DATABASE=app_development
TEST_DB_DATABASE=app_test
DB_POOL=10
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173

# Generate a DIFFERENT value for each key: bundle exec rails secret
SECRET_KEY_BASE=replace-with-generated-local-secret
CUSTOMER_JWT_SECRET=replace-with-generated-local-access-secret
CUSTOMER_JWT_REFRESH_SECRET=replace-with-generated-local-refresh-secret

# letter_opener opens emails locally; development does not need SMTP credentials.
EMAIL_USER=noreply@example.test
EMAIL_FROM=noreply@example.test
SUPPORT_EMAIL=support@example.test
SOLID_QUEUE_IN_PUMA=false
