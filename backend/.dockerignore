# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Local configuration copies and data exports.
/env.txt
/establishment_data.json

# Runtime uploads; keep only the application default images.
/public/uploads/*
!/public/uploads/establishments/
/public/uploads/establishments/*
!/public/uploads/establishments/Avatar-Padrao.jpg
!/public/uploads/establishments/Capa-Padrao.jpg
*.pem
*.p12
*.pfx
*.sql
*.sql.gz
*.dump
*.backup
.aws/
.ssh/
**/*.key
**/*.p8
**/*.jks
**/*.keystore
**/*.sqlite*
**/*.db
**/*.bak
**/*.old
.npmrc
.envrc
/coverage/
