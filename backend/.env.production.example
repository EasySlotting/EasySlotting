# main deployment. Inject these variables into the process/container.
# dotenv is not installed in production; .env files are NOT loaded automatically.
RAILS_ENV=production
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
DB_HOST=db
DB_PORT=5432
DB_USER=easyslotting
DB_PASSWORD=replace-with-production-postgres-password
DB_DATABASE=easyslotting_production
QUEUE_DB_DATABASE=easyslotting_production_queue
CACHE_DB_DATABASE=easyslotting_production_cache
CABLE_DB_DATABASE=easyslotting_production_cable
DB_POOL=5

# Generate a DIFFERENT value for each key: bundle exec rails secret
SECRET_KEY_BASE=replace-with-generated-production-secret
CUSTOMER_JWT_SECRET=replace-with-generated-production-access-secret
CUSTOMER_JWT_REFRESH_SECRET=replace-with-generated-production-refresh-secret
# If encrypted Rails credentials are used, inject RAILS_MASTER_KEY securely too.
# RAILS_MASTER_KEY=replace-with-the-credentials-decryption-key

FRONTEND_URL=https://app.example.com
API_URL=https://app.example.com
# Hosts only, no protocol, path or port. Separate from frontend CORS origins.
ALLOWED_HOSTS=app.example.com
ALLOWED_ORIGINS=https://app.example.com

SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com

WEB_CONCURRENCY=0
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
PORT=3000
JOB_CONCURRENCY=1
JOB_THREADS=1
# Run a separate worker with bin/jobs. Enable true only for a single-process deployment.
SOLID_QUEUE_IN_PUMA=false

# Optional first administrator: generated by scripts/prepare-production.sh.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-production-password
