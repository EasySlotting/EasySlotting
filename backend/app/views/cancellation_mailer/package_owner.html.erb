<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8fafc; margin: 0; padding: 40px 0; }
    .container { max-width: 520px; margin: 0 auto; background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #0f172a, #1e293b); padding: 32px; text-align: center; }
    .header h1 { color: #ffffff; font-size: 22px; margin: 0 0 4px; font-weight: 800; }
    .header p { color: rgba(255,255,255,0.85); font-size: 14px; margin: 0; }
    .body { padding: 32px; }
    .body p { color: #374151; font-size: 15px; line-height: 1.6; margin: 0 0 16px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; background-color: #fee2e2; color: #dc2626; }
    .card { background-color: #f1f5f9; border-radius: 8px; padding: 24px; margin-bottom: 16px; border: 1px solid #e2e8f0; }
    .card-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: #64748b; margin-top: 0; margin-bottom: 16px; letter-spacing: 0.05em; }
    .detail-row { margin-bottom: 12px; font-size: 15px; }
    .detail-row:last-child { margin-bottom: 0; }
    .detail-label { font-weight: 600; color: #475569; }
    .detail-value { color: #0f172a; }
    .reason-box { background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin: 16px 0; }
    .reason-box p { color: #991b1b; margin: 0; font-size: 14px; }
    .footer { padding: 20px 32px; border-top: 1px solid #f0f0f0; text-align: center; }
    .footer p { color: #9ca3af; font-size: 12px; margin: 0 0 4px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= html_escape(@establishment.name) %></h1>
      <p>Pacote Mensal Cancelado</p>
    </div>

    <div class="body">
      <p>Olá!</p>

      <p>Um pacote mensal no seu estabelecimento foi cancelado pelo cliente.</p>

      <span class="badge">Pacote Cancelado</span>

      <div class="card">
        <div class="card-title">Detalhes do Pacote</div>
        <div class="detail-row">
          <span class="detail-label">Cliente:</span>
          <span class="detail-value"><%= html_escape(@customer.name) %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Pacote:</span>
          <span class="detail-value"><%= html_escape(@package.name) %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Serviço:</span>
          <span class="detail-value"><%= html_escape(@package.service&.name || 'N/A') %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Sessões canceladas:</span>
          <span class="detail-value"><%= @sessions_canceled %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Valor:</span>
          <span class="detail-value">R$ <%= number_with_precision(@sale.total_price.to_f, precision: 2, separator: ',', delimiter: '.') %></span>
        </div>
      </div>

      <% if @reason.present? %>
        <div class="reason-box">
          <p><strong>Motivo informado pelo cliente:</strong> <%= html_escape(@reason) %></p>
        </div>
      <% end %>
    </div>

    <div class="footer">
      <p>Este é um e-mail automático. Por favor, não responda.</p>
      <p>&copy; 2026 <%= html_escape(@establishment.name) %> - Todos os direitos reservados.</p>
    </div>
  </div>
</body>
</html>
