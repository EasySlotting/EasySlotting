# staging deployment: production Rails mode with isolated test resources. Inject these variables into the process/container.
# dotenv is not installed in production; .env files are NOT loaded automatically.
RAILS_ENV=production
# VM access: run bash scripts/prepare-staging.sh LINUX_VM_LAN_IPV4
STAGING_HOST=localhost
STAGING_BIND_ADDRESS=127.0.0.1
DB_HOST=db
DB_PORT=5432
DB_USER=easyslotting_staging
DB_PASSWORD=replace-with-staging-postgres-password
DB_DATABASE=easyslotting_staging
QUEUE_DB_DATABASE=easyslotting_staging_queue
CACHE_DB_DATABASE=easyslotting_staging_cache
CABLE_DB_DATABASE=easyslotting_staging_cable
DB_POOL=10

# Generate a DIFFERENT value for each key: bundle exec rails secret
SECRET_KEY_BASE=replace-with-generated-staging-secret
CUSTOMER_JWT_SECRET=replace-with-generated-staging-access-secret
CUSTOMER_JWT_REFRESH_SECRET=replace-with-generated-staging-refresh-secret
# If encrypted Rails credentials are used, inject RAILS_MASTER_KEY securely too.
# RAILS_MASTER_KEY=replace-with-the-credentials-decryption-key

FRONTEND_URL=https://localhost:8443
API_URL=https://localhost:8443
# Hosts only, no protocol, path or port. Separate from frontend CORS origins.
ALLOWED_HOSTS=localhost
ALLOWED_ORIGINS=https://localhost:8443

SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=none
SMTP_ENABLE_STARTTLS_AUTO=false
EMAIL_USER=noreply@example.test
# No SMTP password: use a local capture server, e.g. Mailpit, never real delivery.
EMAIL_FROM=noreply@example.test
SUPPORT_EMAIL=support@example.test

RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
PORT=3000
JOB_CONCURRENCY=1
# Run a separate worker with bin/jobs. Enable true only for a single-process deployment.
SOLID_QUEUE_IN_PUMA=false

# Optional initial administrator; never use a real production account here.
BOOTSTRAP_ADMIN_EMAIL=admin@staging.example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-staging-password
